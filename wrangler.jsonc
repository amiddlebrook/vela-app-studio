{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vela-control-plane",
  "account_id": "07f1b17fd676c14af148ff1d818383a9",
  "main": "src/entry.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ORIGIN": "https://vela-control-plane.averymiddlebrook2014.workers.dev",
    "CLOUDFLARE_ACCOUNT_ID": "07f1b17fd676c14af148ff1d818383a9",
    "OPENROUTER_MODEL": "z-ai/glm-5.2:free",
    "CLOUDFLARE_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },
  "secrets": {
    "required": ["SESSION_SECRET", "TOKEN_ENCRYPTION_KEY"]
  },
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [{ "name": "BUILDS", "class_name": "BuildCoordinator" }]
  },
  "exports": {
    "BuildCoordinator": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "queues": {
    "producers": [{ "binding": "BUILD_JOBS", "queue": "vela-build-jobs" }],
    "consumers": [{ "queue": "vela-build-jobs", "max_batch_size": 10, "max_batch_timeout": 5 }]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vela-control-plane",
      "database_id": "c5056c44-8696-4927-927d-0c16b1d18bfe",
      "migrations_dir": "./migrations"
    }
  ]
}
