{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vela-control-plane",
  "account_id": "07f1b17fd676c14af148ff1d818383a9",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "BUILDS", "class_name": "BuildCoordinator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuildCoordinator"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "queues": { "producers": [{ "binding": "BUILD_JOBS", "queue": "vela-build-jobs" }] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vela-control-plane",
      "database_id": "c5056c44-8696-4927-927d-0c16b1d18bfe",
      "migrations_dir": "./migrations"
    }
  ]
}
